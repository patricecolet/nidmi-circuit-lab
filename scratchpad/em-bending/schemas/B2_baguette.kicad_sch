	(text "B2 — Baguette multi-mode : électroaimant piloté, sélecteur rotatif 2 × 6"
		(exclude_from_sim no)
		(at 26.67 9.13 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
