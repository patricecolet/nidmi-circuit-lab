			)
			(justify left bottom)
		)
		(uuid "f8f88d6b-107e-5bb3-ba88-18d10ae2af28")
	)
	(text "U2A (XOR) sort la somme et la différence ; R5/C5 ne gardent que la différence, audible."
		(exclude_from_sim no)
		(at 7.62 123.06 0)
		(effects
