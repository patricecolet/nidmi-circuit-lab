		(uuid "462cb790-c212-512f-a6b7-931b3debc614")
	)
	(text "f ≈ 1 / (2π √(L · C/2)) : L = 330 µH et C = 2,2 nF donnent ≈ 260 kHz. CV1 accorde U1C/L2 à quelques Hz de U1A/L1."
		(exclude_from_sim no)
		(at 7.62 120.76 0)
		(effects
