	(text "S7 — Absorption (grid-dip) : oscillateur de Clapp + détecteur → CV"
		(exclude_from_sim no)
		(at 11.43 9.13 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "11148ac3-e87e-5dfa-83f1-c888254d128d")
	)
	(text "L1 = 50 µH (bobine de détection, ≈ 25 spires sur Ø 3 cm). C1 = C2 = 47 nF, C3 = 470 nF → f ≈ 150 kHz."
		(exclude_from_sim no)
		(at 7.62 102.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "658a0899-9d8a-553e-b667-8e74b87ee185")
	)
	(text "RV1 : régler juste au-dessus du seuil d'oscillation (sensibilité maximale à l'absorption)."
		(exclude_from_sim no)
		(at 7.62 105.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "edec9c4b-668b-5b5c-9aec-46ecc0534b83")
	)
	(text "Un résonateur G3 accordé sur f approché de L1 prend de l'énergie : l'amplitude chute, DET et CV baissent."
		(exclude_from_sim no)
		(at 7.62 107.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8702cda6-86d0-5243-94e9-415d6fcd7bbd")
	)
	(text "D1/D2 : doubleur-détecteur. CV (0–5 V) va au VCO de S3 (à la place du Hall) ou à un VCA."
		(exclude_from_sim no)
		(at 7.62 109.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fcb7b0ba-e592-5b6d-ba20-b78ec47c47ed")
	)
	(text "Plusieurs canaux : un oscillateur par fréquence (≥ ±20 % d'écart) et un résonateur accordé par doigt."
