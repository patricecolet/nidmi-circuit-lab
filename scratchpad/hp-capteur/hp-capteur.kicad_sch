	(text "Haut-parleur capteur → enveloppe → ADC (XIAO ESP32-C3)"
		(exclude_from_sim no)
		(at 25.4 17.78 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "2ee1b610-b3b9-560c-b94b-234ca8d2d019")
	)
	(text "Frappe de la membrane → Note On/Off + vélocité ; frottement → aftertouch (composants NiDMI)."
		(exclude_from_sim no)
		(at 25.4 21.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4e34296b-b025-5c76-a3d9-b32d15d41da1")
	)
	(text "Gain alternatif = 1 + R4/R5 ≈ 46 (ajuster R5 : 1k → ×100, 4.7k → ×22).  Enveloppe : τ = R7·C5 ≈ 22 ms."
		(exclude_from_sim no)
		(at 25.4 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0e7c835f-4fa1-50f4-a97c-f42cec192bb4")
	)
	(text "Deux voies : ENV (enveloppe analogique) pour les frappes → Velostat ; AMP (préampli brut) pour le frottement → RMS logiciel → aftertouch."
		(exclude_from_sim no)
		(at 25.4 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6e2aa5bb-9ece-5312-88cf-2aada2d335a6")
	)
	(text "D2/D3 (1N4148) limitent l'entrée de l'ampli à −0,6 V / +3,9 V quand on frappe fort ; R9 limite le courant."
		(exclude_from_sim no)
		(at 25.4 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3dfdc644-f827-582a-8558-6075023f3a43")
	)
	(text "VBIAS = 1,25 V (milieu de la plage ADC 0–2,5 V), tamponné par U1B"
		(exclude_from_sim no)
		(at 25.4 105.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9327ec73-0fd3-53a3-af69-e044096caf6b")
	)
	(text "D1 = 1N4148 : seuil ≈ 0,5 V (porte de bruit).\nRégler velocityMax ≈ 1500–1800 dans le Velostat."
		(exclude_from_sim no)
		(at 124.46 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1d31f667-fb8d-5a58-b5c2-19b3e48189e4")
	)
	(text "J1 vers XIAO :\n1 = 3V3\n2 = ENV → broche D0 (GPIO2) : frappes\n3 = AMP → broche D1 (GPIO3) : frottement\n4 = GND"
		(exclude_from_sim no)
		(at 180.34 53.34 0)
		(effects
